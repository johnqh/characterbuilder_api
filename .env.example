# --- Core ---
PORT=8040
DATABASE_URL=postgres://user:pass@localhost:5432/characterbuilder
# SKIP_DB_INIT=1          # skip CREATE TABLE on boot (schema already applied)
LOG_LEVEL=info
PUBLIC_APP_URL=http://localhost:5173   # CORS origin
# CORS_ORIGINS=https://app.example.com,https://other.example.com

# --- Auth (Firebase) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
SITEADMIN_EMAILS=
# AUTH_TEST_MODE=1        # accept `Bearer dev:<uid>:<email>` tokens (dev only)

# --- Image generation (ShapeShyft) ---
SHAPESHYFT_ENDPOINT_URL=https://api.shapeshyft.ai/api/v1/ai/<org>/<project>
SHAPESHYFT_API_KEY=sk_live_...
SHAPESHYFT_IMAGE_ENDPOINT=character-image
SHAPESHYFT_TIMEOUT_MS=240000

# --- Storage ---
STORAGE_DRIVER=local       # memory | local
STORAGE_DIR=./.storage

# --- Credits / RevenueCat ---
INITIAL_FREE_CREDITS=20
CREDIT_PRODUCTS=cb_credits_100:100,cb_credits_500:500
REVENUECAT_WEBHOOK_AUTH=
